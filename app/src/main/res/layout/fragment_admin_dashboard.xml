<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FDFDFD"> <ScrollView
    android:layout_width="0dp"
    android:layout_height="0dp"
    android:scrollbars="none"
    app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <TextView
            android:id="@+id/tv_stat_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Statistik Tutor Aktif"
            android:textColor="#1E1E24"
            android:textSize="24sp"
            android:fontFamily="sans-serif-black"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <androidx.cardview.widget.CardView
            android:id="@+id/card_stats"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#EEF2F6"
            app:layout_constraintTop_toBottomOf="@id/tv_stat_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="18dp">

                <TextView
                    android:id="@+id/tv_tutor_count"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Tutor Mengajar: 14"
                    android:textColor="#1E1E24"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-medium"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/tv_empty_schedules" />

                <TextView
                    android:id="@+id/tv_empty_schedules"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Jadwal Kosong: 2 ⚠️"
                    android:textColor="#F43F5E"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-bold"
                    android:textStyle="bold"
                    android:textAlignment="viewEnd"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@id/tv_tutor_count"
                    app:layout_constraintEnd_toEndOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLihatLeaveRequest"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:text="Lihat Permintaan Ganti Jadwal"
            android:textStyle="bold"
            app:cornerRadius="12dp"
            app:backgroundTint="#4F46E5"
            android:textColor="@android:color/white"
            app:layout_constraintTop_toBottomOf="@id/card_stats"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <TextView
            android:id="@+id/tv_ai_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="AI Burnout Optimizer"
            android:textColor="#4361EE" android:textSize="20sp"
            android:fontFamily="sans-serif-black"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/btnLihatLeaveRequest"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btn_refresh_ai" />

        <Button
            android:id="@+id/btn_refresh_ai"
            style="?attr/materialIconButtonStyle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:icon="@android:drawable/stat_notify_sync"
            app:iconTint="#4361EE" app:layout_constraintTop_toTopOf="@id/tv_ai_title"
            app:layout_constraintBottom_toBottomOf="@id/tv_ai_title"
            app:layout_constraintEnd_toEndOf="parent" />

        <androidx.cardview.widget.CardView
            android:id="@+id/card_ai"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#F0F4FF" app:strokeColor="#4361EE" app:strokeWidth="1dp"
            app:layout_constraintTop_toBottomOf="@id/tv_ai_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tv_ai_content"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Ketuk tombol refresh di atas untuk meminta rekomendasi pembagian beban kerja optimal dari Gemini AI."
                    android:textColor="#3A0CA3" android:textSize="14sp"
                    android:fontFamily="sans-serif"
                    android:lineSpacingExtra="5dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>