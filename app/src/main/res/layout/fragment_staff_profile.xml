<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F8FAFC">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <!-- AVATAR PROFILE DENGAN BACKGROUND DAN ELEVASi MODERN -->

        <!-- NAMA UTAMA (BOLD DAN LEBIH TEGAS) -->

        <!-- USERNAME SUBTEXT -->

        <TextView
            android:id="@+id/tvProfileName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="60dp"
            android:fontFamily="sans-serif-medium"
            android:text="Memuat Nama..."
            android:textColor="#0F172A"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvProfileUsername"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@username"
            android:textSize="14sp"
            android:fontFamily="sans-serif"
            android:textColor="#64748B"
            app:layout_constraintTop_toBottomOf="@id/tvProfileName"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- KARTU INFORMASI AKUN -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="#E2E8F0"
            app:cardBackgroundColor="@android:color/white"
            app:layout_constraintTop_toBottomOf="@id/tvProfileUsername"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Informasi Akun"
                    android:fontFamily="sans-serif-medium"
                    android:textStyle="bold"
                    android:textColor="#4F46E5"
                    android:textSize="15sp"
                    android:layout_marginBottom="16dp"/>

                <!-- Item 1: Email -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Email Terdaftar"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="#94A3B8"/>
                <TextView
                    android:id="@+id/tvProfileEmail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="email@domain.com"
                    android:textColor="#1E293B"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:layout_marginBottom="16dp"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#F1F5F9"
                    android:layout_marginBottom="16dp"/>

                <!-- Item 2: Role -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Peran Sistem (Role)"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="#94A3B8"/>
                <TextView
                    android:id="@+id/tvProfileRole"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Staff Lapangan"
                    android:textStyle="bold"
                    android:textColor="#1E293B"
                    android:textSize="14sp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- KARTU KONFIGURASI NFC -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardNfcConfiguration"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="#E2E8F0"
            app:cardBackgroundColor="@android:color/white"
            app:layout_constraintTop_toBottomOf="@id/cardInfo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:gravity="center_horizontal">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Pengaturan Kartu Absensi NFC"
                    android:fontFamily="sans-serif-medium"
                    android:textStyle="bold"
                    android:textColor="#4F46E5"
                    android:textSize="15sp"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Tempelkan kartu atau HP berfitur NFC ke belakang perangkat ini saat halaman ini terbuka untuk meregistrasikan ID Absensi baru."
                    android:textSize="13sp"
                    android:lineSpacingMultiplier="1.1"
                    android:textColor="#64748B"
                    android:layout_marginBottom="20dp"/>

                <!-- BADGE INDIKATOR BERBENTUK KOTAK PRESISI/BULAT KECIL -->
                <View
                    android:id="@+id/viewNfcIndicator"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:background="#94A3B8"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/tvNfcStatusText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Status NFC: Belum Dikonfigurasi"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:textColor="#334155"
                    android:layout_marginBottom="6dp"/>

                <TextView
                    android:id="@+id/tvNfcUidValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="UID: -- -- -- --"
                    android:fontFamily="monospace"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#64748B"
                    android:layout_marginBottom="24dp"/>

                <!-- TOMBOL UTAMA MODERN DENGAN CORNER ROUNDED NYAMAN -->
                <Button
                    android:id="@+id/btnStartNfcScan"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:text="Mulai Registrasi Kartu"
                    app:backgroundTint="#4F46E5"
                    android:textColor="@android:color/white"
                    app:cornerRadius="12dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:textSize="15sp"
                    android:textStyle="bold"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>