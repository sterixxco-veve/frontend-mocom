<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:padding="20dp">

    <TextView
        android:id="@+id/tv_broadcast_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Admin Broadcast"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tv_broadcast_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Kirim pengumuman delegasi asdos darurat atau info kelas kosong secara instan."
        android:textColor="#94A3B8"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/tv_broadcast_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Card Input Form -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_form"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:cardCornerRadius="12dp"
        app:cardBackgroundColor="#1E293B"
        app:layout_constraintTop_toBottomOf="@id/tv_broadcast_subtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <!-- Subjek -->
            <TextView
                android:id="@+id/tv_subject_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Subjek Broadcast"
                android:textColor="#06B6D4"
                android:textSize="12sp"
                android:textStyle="bold"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <EditText
                android:id="@+id/et_subject"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="#0F172A"
                android:hint="Contoh: Urgent - Jadwal Ganti Alpro"
                android:textColor="#FFFFFF"
                android:textColorHint="#475569"
                android:paddingHorizontal="12dp"
                android:textSize="14sp"
                android:inputType="text"
                app:layout_constraintTop_toBottomOf="@id/tv_subject_label"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Detail Pesan -->
            <TextView
                android:id="@+id/tv_message_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Detail Pesan Handover"
                android:textColor="#06B6D4"
                android:textSize="12sp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/et_subject"
                app:layout_constraintStart_toStartOf="parent" />

            <EditText
                android:id="@+id/et_message"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_marginTop="6dp"
                android:background="#0F172A"
                android:hint="Tulis instruksi materi praktikum atau catatan penting di sini..."
                android:textColor="#FFFFFF"
                android:textColorHint="#475569"
                android:padding="12dp"
                android:textSize="14sp"
                android:gravity="top|start"
                android:inputType="textMultiLine"
                app:layout_constraintTop_toBottomOf="@id/tv_message_label"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Tombol Kirim -->
            <Button
                android:id="@+id/btn_send_broadcast"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginTop="16dp"
                android:text="🚀 Kirim Broadcast Sekarang"
                android:backgroundTint="#06B6D4"
                android:textColor="#0F172A"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/et_message"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

    <!-- Riwayat Header -->
    <TextView
        android:id="@+id/tv_history_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Riwayat Broadcast Hari Ini"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/card_form"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Scroll History -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/tv_history_title"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/ll_broadcast_history"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <!-- Item Default -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    app:cardCornerRadius="8dp"
                    app:cardBackgroundColor="#1E293B">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="12dp">

                        <TextView
                            android:id="@+id/tv_item_title"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="⚠️ INFO DELEGASI: Kelas Teori Alpro Shift 1"
                            android:textColor="#F43F5E"
                            android:textStyle="bold"
                            android:textSize="13sp"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent" />

                        <TextView
                            android:id="@+id/tv_item_desc"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Andi Wijaya berhalangan hadir. Digantikan Budi Santoso. Materi: Array List."
                            android:textColor="#94A3B8"
                            android:textSize="12sp"
                            app:layout_constraintTop_toBottomOf="@id/tv_item_title"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent" />

                        <TextView
                            android:id="@+id/tv_item_meta"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="Sistem Sinkron • Dikirim 15 menit lalu"
                            android:textColor="#475569"
                            android:textSize="10sp"
                            app:layout_constraintTop_toBottomOf="@id/tv_item_desc"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent" />

                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>