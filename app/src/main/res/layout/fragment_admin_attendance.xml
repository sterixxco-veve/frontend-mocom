<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:padding="20dp">

    <TextView
        android:id="@+id/tv_title_attendance"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Monitoring Absensi"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Header Subtitle -->
    <TextView
        android:id="@+id/tv_subtitle_attendance"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Pantau kehadiran asisten dosen di lab secara realtime hari ini."
        android:textColor="#94A3B8"
        android:textSize="14sp"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/tv_title_attendance"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- STREAMING_CHUNK: Designing the filter buttons container... -->
    <!-- Filter Section using ConstraintLayout chaining -->
    <Button
        android:id="@+id/btn_filter_all"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:text="Semua"
        android:textSize="12sp"
        android:backgroundTint="#06B6D4"
        android:textColor="#0F172A"
        app:layout_constraintTop_toBottomOf="@id/tv_subtitle_attendance"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btn_filter_present"
        app:layout_constraintHorizontal_chainStyle="spread" />

    <Button
        android:id="@+id/btn_filter_present"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:layout_marginStart="6dp"
        android:text="Hadir (3)"
        android:textSize="12sp"
        android:backgroundTint="#1E293B"
        android:textColor="#CBD5E1"
        app:layout_constraintTop_toBottomOf="@id/tv_subtitle_attendance"
        app:layout_constraintStart_toEndOf="@id/btn_filter_all"
        app:layout_constraintEnd_toStartOf="@id/btn_filter_absent" />

    <Button
        android:id="@+id/btn_filter_absent"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:layout_marginStart="6dp"
        android:text="Absen (1)"
        android:textSize="12sp"
        android:backgroundTint="#1E293B"
        android:textColor="#CBD5E1"
        app:layout_constraintTop_toBottomOf="@id/tv_subtitle_attendance"
        app:layout_constraintStart_toEndOf="@id/btn_filter_present"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- STREAMING_CHUNK: Adding the scrollable list of attendance items... -->
    <!-- Scrollable Staff Attendance List -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/btn_filter_all"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- STREAMING_CHUNK: Styling staff card 1 (Andi Wijaya)... -->
            <!-- Card 1: Andi Wijaya (Hadir) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_attendance_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="10dp"
                app:cardBackgroundColor="#1E293B"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tv_name_1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Andi Wijaya"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/tv_status_1" />

                    <TextView
                        android:id="@+id/tv_desc_1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Lab Alpro Shift 1 (08:00 WIB)"
                        android:textColor="#94A3B8"
                        android:textSize="12sp"
                        android:layout_marginTop="2dp"
                        app:layout_constraintTop_toBottomOf="@id/tv_name_1"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/tv_status_1" />

                    <TextView
                        android:id="@+id/tv_status_1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hadir ✔"
                        android:textColor="#10B981"
                        android:textStyle="bold"
                        android:background="#064E3B"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>

            <!-- STREAMING_CHUNK: Styling staff card 2 (Siti Rahma)... -->
            <!-- Card 2: Siti Rahma (Sakit) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_attendance_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="10dp"
                app:cardBackgroundColor="#1E293B"
                app:layout_constraintTop_toBottomOf="@id/card_attendance_1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tv_name_2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Siti Rahma"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/tv_status_2" />

                    <TextView
                        android:id="@+id/tv_desc_2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Lab Basis Data Shift 2 (10:30 WIB)"
                        android:textColor="#94A3B8"
                        android:textSize="12sp"
                        android:layout_marginTop="2dp"
                        app:layout_constraintTop_toBottomOf="@id/tv_name_2"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/tv_status_2" />

                    <TextView
                        android:id="@+id/tv_status_2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sakit 🤒"
                        android:textColor="#F43F5E"
                        android:textStyle="bold"
                        android:background="#4C0519"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>

            <!-- STREAMING_CHUNK: Styling staff card 3 (Budi Santoso)... -->
            <!-- Card 3: Budi Santoso (Hadir) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_attendance_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="10dp"
                app:cardBackgroundColor="#1E293B"
                app:layout_constraintTop_toBottomOf="@id/card_attendance_2"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tv_name_3"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Budi Santoso"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/tv_status_3" />

                    <TextView
                        android:id="@+id/tv_desc_3"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Ruang Teori 401 Shift 3 (13:00 WIB)"
                        android:textColor="#94A3B8"
                        android:textSize="12sp"
                        android:layout_marginTop="2dp"
                        app:layout_constraintTop_toBottomOf="@id/tv_name_3"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/tv_status_3" />

                    <TextView
                        android:id="@+id/tv_status_3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hadir ✔"
                        android:textColor="#10B981"
                        android:textStyle="bold"
                        android:background="#064E3B"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>