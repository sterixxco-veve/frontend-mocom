<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FDFDFD"
    android:padding="24dp">

    <TextView
        android:id="@+id/tv_title_attendance_monitoring"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Monitoring Absensi Staff"
        android:textColor="#1E1E24"
        android:textSize="26sp"
        android:fontFamily="sans-serif-black"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tv_subtitle_attendance_monitoring"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Pantau rekam jejak jam masuk, keluar, dan keterlambatan asisten/staff laboratorium."
        android:textColor="#8D99AE"
        android:textSize="14sp"
        android:fontFamily="sans-serif-medium"
        android:lineSpacingExtra="3dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/tv_title_attendance_monitoring"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <HorizontalScrollView
        android:id="@+id/hsv_filters"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:scrollbars="none"
        android:overScrollMode="never"
        app:layout_constraintTop_toBottomOf="@id/tv_subtitle_attendance_monitoring"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingEnd="24dp"
            android:paddingBottom="4dp">

            <Button
                android:id="@+id/btn_filter_all"
                android:layout_width="wrap_content"
                android:layout_height="50dp"
                android:minWidth="105dp"
                android:text="Semua"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold"
                android:backgroundTint="#4361EE"
                android:textColor="@android:color/white"
                android:stateListAnimator="@null"
                app:cornerRadius="12dp" />

            <Button
                android:id="@+id/btn_filter_present"
                android:layout_width="wrap_content"
                android:layout_height="50dp"
                android:layout_marginStart="12dp"
                android:minWidth="105dp"
                android:text="Present"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold"
                android:backgroundTint="#EEF2F6"
                android:textColor="#8D99AE"
                android:stateListAnimator="@null"
                app:cornerRadius="12dp" />

            <Button
                android:id="@+id/btn_filter_late"
                android:layout_width="wrap_content"
                android:layout_height="50dp"
                android:layout_marginStart="12dp"
                android:minWidth="105dp"
                android:text="Late"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold"
                android:backgroundTint="#EEF2F6"
                android:textColor="#8D99AE"
                android:stateListAnimator="@null"
                app:cornerRadius="12dp" />

            <Button
                android:id="@+id/btn_filter_absent"
                android:layout_width="wrap_content"
                android:layout_height="50dp"
                android:layout_marginStart="12dp"
                android:minWidth="105dp"
                android:text="Absent"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold"
                android:backgroundTint="#EEF2F6"
                android:textColor="#8D99AE"
                android:stateListAnimator="@null"
                app:cornerRadius="12dp" />
        </LinearLayout>
    </HorizontalScrollView>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshAttendance"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/hsv_filters"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvAttendanceHistory"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="24dp"
            tools:listitem="@layout/item_attendance" />

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</androidx.constraintlayout.widget.ConstraintLayout>