<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FDFDFD"
    android:padding="24dp">

    <TextView
        android:id="@+id/tv_title_attendance"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Monitoring Absensi"
        android:textColor="#1E1E24"
        android:textSize="26sp"
        android:fontFamily="sans-serif-black"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tv_subtitle_attendance"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Pantau kehadiran asisten dosen di lab secara realtime hari ini."
        android:textColor="#8D99AE"
        android:textSize="14sp"
        android:fontFamily="sans-serif-medium"
        android:lineSpacingExtra="3dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/tv_title_attendance"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/btn_filter_all"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_marginTop="20dp"
        android:text="Semua"
        android:textSize="13sp"
        android:fontFamily="sans-serif-medium"
        android:textStyle="bold"
        android:backgroundTint="#4361EE"
        android:textColor="@android:color/white"
        android:stateListAnimator="@null"
        app:cornerRadius="12dp"
        app:layout_constraintTop_toBottomOf="@id/tv_subtitle_attendance"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btn_filter_present"
        app:layout_constraintHorizontal_chainStyle="spread" />

    <Button
        android:id="@+id/btn_filter_present"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_marginTop="20dp"
        android:layout_marginStart="8dp"
        android:text="Hadir (3)"
        android:textSize="13sp"
        android:fontFamily="sans-serif-medium"
        android:textStyle="bold"
        android:backgroundTint="#EEF2F6"
        android:textColor="#8D99AE"
        android:stateListAnimator="@null"
        app:cornerRadius="12dp"
        app:layout_constraintTop_toBottomOf="@id/tv_subtitle_attendance"
        app:layout_constraintStart_toEndOf="@id/btn_filter_all"
        app:layout_constraintEnd_toStartOf="@id/btn_filter_absent" />

    <Button
        android:id="@+id/btn_filter_absent"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_marginTop="20dp"
        android:layout_marginStart="8dp"
        android:text="Absen (1)"
        android:textSize="13sp"
        android:fontFamily="sans-serif-medium"
        android:textStyle="bold"
        android:backgroundTint="#EEF2F6"
        android:textColor="#8D99AE"
        android:stateListAnimator="@null"
        app:cornerRadius="12dp"
        app:layout_constraintTop_toBottomOf="@id/tv_subtitle_attendance"
        app:layout_constraintStart_toEndOf="@id/btn_filter_present"
        app:layout_constraintEnd_toEndOf="parent" />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/btn_filter_all"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.cardview.widget.CardView
                android:id="@+id/card_attendance_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#EEF2F6"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tv_name_1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Andi Wijaya"
                        android:textColor="#1E1E24"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:fontFamily="sans-serif-medium"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/tv_status_1" />

                    <TextView
                        android:id="@+id/tv_desc_1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Lab Alpro Shift 1 (08:00 WIB)"
                        android:textColor="#8D99AE"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif"
                        android:layout_marginTop="4dp"
                        app:layout_constraintTop_toBottomOf="@id/tv_name_1"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/tv_status_1" />

                    <TextView
                        android:id="@+id/tv_status_1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hadir ✔"
                        android:textColor="#10B981"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-bold"
                        android:background="#E6F4EA"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/card_attendance_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#EEF2F6"
                app:layout_constraintTop_toBottomOf="@id/card_attendance_1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tv_name_2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Siti Rahma"
                        android:textColor="#1E1E24"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:fontFamily="sans-serif-medium"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/tv_status_2" />

                    <TextView
                        android:id="@+id/tv_desc_2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Lab Basis Data Shift 2 (10:30 WIB)"
                        android:textColor="#8D99AE"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif"
                        android:layout_marginTop="4dp"
                        app:layout_constraintTop_toBottomOf="@id/tv_name_2"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/tv_status_2" />

                    <TextView
                        android:id="@+id/tv_status_2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sakit 🤒"
                        android:textColor="#F43F5E"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-bold"
                        android:background="#FCE8E6"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/card_attendance_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#EEF2F6"
                app:layout_constraintTop_toBottomOf="@id/card_attendance_2"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tv_name_3"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Budi Santoso"
                        android:textColor="#1E1E24"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:fontFamily="sans-serif-medium"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/tv_status_3" />

                    <TextView
                        android:id="@+id/tv_desc_3"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Ruang Teori 401 Shift 3 (13:00 WIB)"
                        android:textColor="#8D99AE"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif"
                        android:layout_marginTop="4dp"
                        app:layout_constraintTop_toBottomOf="@id/tv_name_3"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/tv_status_3" />

                    <TextView
                        android:id="@+id/tv_status_3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hadir ✔"
                        android:textColor="#10B981"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-bold"
                        android:background="#E6F4EA"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>