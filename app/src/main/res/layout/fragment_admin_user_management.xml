<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FDFDFD"
    android:padding="24dp">

    <TextView
        android:id="@+id/tv_title_user_management"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Manajemen User"
        android:textColor="#1E1E24"
        android:textSize="26sp"
        android:fontFamily="sans-serif-black"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tv_subtitle_user_management"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Kelola, filter, dan pantau status aktif staff serta member."
        android:textColor="#8D99AE"
        android:textSize="14sp"
        android:fontFamily="sans-serif-medium"
        android:lineSpacingExtra="3dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/tv_title_user_management"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/btn_filter_staff"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_marginTop="20dp"
        android:text="Staff"
        android:textSize="13sp"
        android:fontFamily="sans-serif-medium"
        android:textStyle="bold"
        android:backgroundTint="#4361EE"
        android:textColor="@android:color/white"
        android:stateListAnimator="@null"
        app:cornerRadius="12dp"
        app:layout_constraintTop_toBottomOf="@id/tv_subtitle_user_management"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btn_filter_member"
        app:layout_constraintHorizontal_chainStyle="spread" />

    <Button
        android:id="@+id/btn_filter_member"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_marginTop="20dp"
        android:layout_marginStart="12dp"
        android:text="Member"
        android:textSize="13sp"
        android:fontFamily="sans-serif-medium"
        android:textStyle="bold"
        android:backgroundTint="#EEF2F6"
        android:textColor="#8D99AE"
        android:stateListAnimator="@null"
        app:cornerRadius="12dp"
        app:layout_constraintTop_toBottomOf="@id/tv_subtitle_user_management"
        app:layout_constraintStart_toEndOf="@id/btn_filter_staff"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshUser"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/btn_filter_staff"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvAdminUserManagement"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="80dp"
            tools:listitem="@layout/item_user" />

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_add_user"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:backgroundTint="#4361EE"
        app:srcCompat="@android:drawable/ic_input_add"
        app:tint="#FFFFFF"
        app:elevation="4dp"
        app:pressedTranslationZ="8dp"
        app:fabSize="normal"
        app:useCompatPadding="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:contentDescription="Tambah User Baru" />

</androidx.constraintlayout.widget.ConstraintLayout>