<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:padding="20dp">

    <TextView
        android:id="@+id/tv_title_reports"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Laporan Kehadiran &amp; AI Burnout"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Tombol Unduh Laporan Kehadiran -->
    <Button
        android:id="@+id/btn_download_attendance"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginTop="24dp"
        android:text="📥 Download Laporan Kehadiran"
        android:backgroundTint="#1E293B"
        android:textColor="#FFFFFF"
        app:layout_constraintTop_toBottomOf="@id/tv_title_reports"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Tombol Unduh Laporan Risiko Burnout -->
    <Button
        android:id="@+id/btn_download_burnout"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:text="📥 Download Laporan Burnout AI"
        android:backgroundTint="#1E293B"
        android:textColor="#FFFFFF"
        app:layout_constraintTop_toBottomOf="@id/btn_download_attendance"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- PDF Viewer Frame Placeholder Title -->
    <TextView
        android:id="@+id/tv_pdf_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="PDF Viewer Terintegrasi (Preview)"
        android:textColor="#06B6D4"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/btn_download_burnout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- PDF Viewer Frame Placeholder -->
    <FrameLayout
        android:id="@+id/pdf_viewer_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:background="#1E293B"
        app:layout_constraintTop_toBottomOf="@id/tv_pdf_title"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tv_pdf_placeholder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Belum ada PDF yang dibuka. Silakan klik salah satu unduhan diatas."
            android:textColor="#94A3B8"
            android:gravity="center"
            android:padding="16dp"/>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>